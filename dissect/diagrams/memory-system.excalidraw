      "boundElements": null,
      "updated": 1774141925285,
      "link": null,
      "locked": false,
      "text": "OpenClaw Memory System Summary:\n\n• IDENTITY.md - Who the agent is (name, creature type, personality)\n• USER.md - Who the human is (name, timezone, preferences)\n• SOUL.md - Agent's core values and behavior rules\n• AGENTS.md - Workspace instructions and memory workflow\n• MEMORY.md - Curated long-term memory (private sessions only)\n• memory/YYYY-MM-DD.md - Daily logs (today + yesterday loaded)\n• BOOTSTRAP.md - One-time first-run setup (deleted after)\n• BOOT.md - Runs at each session startup",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "OpenClaw Memory System Summary:\n\n• IDENTITY.md - Who the agent is (name, creature type, personality)\n• USER.md - Who the human is (name, timezone, preferences)\n• SOUL.md - Agent's core values and behavior rules\n• AGENTS.md - Workspace instructions and memory workflow\n• MEMORY.md - Curated long-term memory (private sessions only)\n• memory/YYYY-MM-DD.md - Daily logs (today + yesterday loaded)\n• BOOTSTRAP.md - One-time first-run setup (deleted after)\n• BOOT.md - Runs at each session startup",
      "autoResize": true,
      "lineHeight": 1.25,
      "syncedAt": "2026-03-22T01:12:13.745Z",
